# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real credentials. See config/app.php for the loader that reads this.

# Set to "true" to have email failures return detailed error messages to the API response.
# Leave unset/"false" in production.
APP_DEBUG=false

# --- Mail --------------------------------------------------------------------
# Options: "brevo", "smtp", or "log" (default fallback if unset)
MAIL_DRIVER=brevo

# Brevo HTTP REST API Key (https://api.brevo.com/v3/smtp/email)
BREVO_API_KEY=xkeysib-your-brevo-api-key

# Gmail / Custom SMTP Fallback (when MAIL_DRIVER=smtp)
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_ENCRYPTION=tls
MAIL_SMTP_USER=your-address@gmail.com
MAIL_SMTP_PASS=your-16-char-app-password

# From address/name shown to recipients
MAIL_FROM=noreply@stocksmart.live
MAIL_FROM_NAME=StockSmart

# --- Database (optional — defaults match stock install) -------------------
# STOCKSMART_DB_HOST=127.0.0.1
# STOCKSMART_DB_PORT=3306
# STOCKSMART_DB_NAME=stocksmart
# STOCKSMART_DB_USER=root
# STOCKSMART_DB_PASS=

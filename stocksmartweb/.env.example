# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real credentials. See config/app.php for the loader that reads this.

# Set to "true" to have SMTP failures return the full PHPMailer error + SMTP
# transcript to the API response (forgot-password.php), not just to
# logs/mail_errors.log. Leave unset/"false" in production.
APP_DEBUG=false

# --- Mail --------------------------------------------------------------------
# Only forgot-password.php sends email (registration no longer requires email
# verification). "smtp" sends real email via PHPMailer. Leave unset (or "log")
# to only write outgoing mail to logs/mail.log instead of sending it (local
# dev only).
MAIL_DRIVER=smtp

# Gmail: smtp.gmail.com, port 587, encryption "tls" (STARTTLS).
# (Port 465 with encryption "ssl" also works if you prefer implicit TLS.)
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_ENCRYPTION=tls

# Full Gmail address you're sending from.
MAIL_SMTP_USER=your-address@gmail.com

# 16-character Gmail App Password (NOT your normal Gmail password) — see
# https://myaccount.google.com/apppasswords. Requires 2-Step Verification
# to be enabled on the Google account first.
MAIL_SMTP_PASS=your-16-char-app-password

# From address/name shown to recipients. Usually the same as MAIL_SMTP_USER
# for Gmail, since Gmail rejects a From address it doesn't own.
MAIL_FROM=your-address@gmail.com
MAIL_FROM_NAME=StockSmart

# --- Database (optional — defaults match a stock XAMPP install) ------------
# STOCKSMART_DB_HOST=127.0.0.1
# STOCKSMART_DB_PORT=3306
# STOCKSMART_DB_NAME=stocksmart
# STOCKSMART_DB_USER=root
# STOCKSMART_DB_PASS=
